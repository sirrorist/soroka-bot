# Отдельный бот от BotFather; токен основного Soroka не использовать.
SOBRIETY_BOT_TOKEN=
SOBRIETY_BOT_USERNAME=
# JSON-массив пользователей: поля user_id (число), username (строка без @).
# JSON-массив привязок: user_id, chat_id (число), необязательный thread_id (число).
