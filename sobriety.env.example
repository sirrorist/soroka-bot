# Отдельный бот от BotFather; токен основного Soroka не использовать.
SOBRIETY_BOT_TOKEN=
SOBRIETY_BOT_USERNAME=
# JSON-массив пользователей: поля user_id (число), username (строка без @).
# JSON-массив привязок: user_id, chat_id (число), необязательный thread_id (число).
# Пустые массивы намеренно не запускают бота. Настоящие значения - только вне git.
SOBRIETY_USERS=[]
SOBRIETY_BINDINGS=[]
# Необязательно: общение с ИИ в личке разрешённых пользователей через
# OpenAI-совместимый роутер. Пустые три значения - функция выключена.
# Адрес (https, с /v1), ключ и идентификатор модели/комбо - только вне git.
SOBRIETY_LLM_BASE_URL=
SOBRIETY_LLM_API_KEY=
SOBRIETY_LLM_MODEL=
# Необязательно: лимит токенов ответа вместе с рассуждением (256-8000, по умолчанию 2000),
# бюджет истории в символах (0-60000, по умолчанию 6000), свой системный промпт.
# SOBRIETY_LLM_MAX_TOKENS=
# SOBRIETY_LLM_HISTORY_CHARS=
# SOBRIETY_LLM_SYSTEM=
# Рассуждение модели: low (по умолчанию), medium, high, none; off - параметр не передаётся (Claude).
# SOBRIETY_LLM_REASONING_EFFORT=
